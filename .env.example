# =====================================================================
#  Postiz — configuration de TON instance.
#  Copié en .env par scripts/setup (qui remplit FUNNEL_HOST et JWT_SECRET).
#  .env est ignoré par git : il ne quitte jamais ce PC.
# =====================================================================

# --- URL publique (Tailscale Funnel) -----------------------------------
# Rempli par setup depuis `tailscale status --json` (Self.DNSName).
# Exemple : mon-pc.tail1234.ts.net
FUNNEL_HOST=
POSTIZ_PORT=4007

MAIN_URL=https://${FUNNEL_HOST}
FRONTEND_URL=https://${FUNNEL_HOST}
NEXT_PUBLIC_BACKEND_URL=https://${FUNNEL_HOST}/api
BACKEND_INTERNAL_URL=http://localhost:3000

# --- Sécurité ------------------------------------------------------------
# Généré par setup. Sert aussi de clé de chiffrement des tokens sociaux en base :
# NE JAMAIS le changer après avoir lié un compte, sinon tous les comptes sont à relier.
# Il est inclus dans chaque backup chiffré.
JWT_SECRET=

# --- Base de données / Redis / Temporal (internes au réseau Docker) -------
POSTGRES_USER=postiz-user
POSTGRES_PASSWORD=postiz-password
POSTGRES_DB=postiz-db-local
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postiz-postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://postiz-redis:6379
TEMPORAL_ADDRESS=temporal:7233

# --- Comportement ----------------------------------------------------------
IS_GENERAL=true
# Passer à true dès que ton compte est créé (sinon n'importe qui sur l'URL peut s'inscrire).
DISABLE_REGISTRATION=false
RUN_CRON=true
API_LIMIT=30
NX_ADD_PLUGINS=false

# --- Stockage des médias (local = ./data/uploads, servi par Funnel) --------
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# --- Clés des réseaux sociaux ------------------------------------------------
# Une paire par réseau, créée par TOI sur le portail développeur du réseau.
# Redirect URI à déclarer : https://<FUNNEL_HOST>/integrations/social/<réseau>
# Guide par réseau : https://docs.postiz.com/providers/<réseau>
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BEEHIIVE_API_KEY=
BEEHIIVE_PUBLICATION_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# --- Optionnel -----------------------------------------------------------------
# IA pour la rédaction des posts (facultatif)
OPENAI_API_KEY=
NEXT_PUBLIC_DISCORD_SUPPORT=
NEXT_PUBLIC_POLOTNO=

# Raccourcisseur de liens — NÉCESSAIRE pour compter les clics sur tes liens.
# Un seul suffit. Dub a un plan gratuit.
# DUB_TOKEN=
# DUB_API_ENDPOINT=https://api.dub.co
# DUB_SHORT_LINK_DOMAIN=dub.sh
# SHORT_IO_SECRET_KEY=
# KUTT_API_KEY=
# KUTT_API_ENDPOINT=https://kutt.it/api/v2
# KUTT_SHORT_LINK_DOMAIN=kutt.it

# Paiement (inutile en auto-hébergé, laissé vide)
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=
STRIPE_SIGNING_KEY_CONNECT=
